# Copy this file to .env for local development.
#
# LAKEBASE_URL is a LOCAL-ONLY convenience: app.py loads this file at startup and
# lakebase.py uses LAKEBASE_URL when it is set. Deployed on Databricks Apps there
# is no .env, so it falls back to reading the "database/lakebase-url" secret via
# the Databricks SDK using the scope/key names app.yaml sets.
#
# Do NOT put a real secret value in this file, and do not commit a filled-in .env
# (.env is gitignored).

LAKEBASE_URL=postgresql://<role>:<password>@<your-lakebase-host>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# lakebase.py / tmdb_client.py build a Databricks WorkspaceClient at import time,
# so local runs need valid Databricks auth even when LAKEBASE_URL is set. If your
# ~/.databrickscfg has no [DEFAULT] profile, point the SDK at a named one here:
# DATABRICKS_CONFIG_PROFILE=<your-profile>

# TMDB (movie data) - used by tmdb_client.py / notebooks/ingest_tmdb_movies.py.
# Store the TMDB API Read Access Token (v4 auth) in the tmdb/api-key secret; the
# app resolves it the same way as LAKEBASE (SDK secret when deployed).
TMDB_API_BASE_URL=https://api.themoviedb.org/3
TMDB_SECRET_SCOPE=tmdb
TMDB_SECRET_KEY=api-key

# Uncomment to enable Flask's debug reloader locally. Never set this in app.yaml -
# the Werkzeug debugger exposes an interactive Python console on any error page.
# FLASK_DEBUG=1
